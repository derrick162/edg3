# EDG3 — environment variable template. Copy to .env.local and fill in real values.
# This file carries NO secrets — it is tracked in git as documentation.

# ── Session signing (REQUIRED) ──────────────────────────────────────────────────
# Signs session JWTs. MUST be a long random string (≥ 32 chars). The app refuses to
# start (and refuses to sign/verify sessions) if this is unset, too short, or a
# placeholder — see validateJwtSecret() in lib/auth.ts.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Field encryption at rest (REQUIRED in prod) ─────────────────────────────────
# AES-256-GCM key for encrypting tokens/transcripts/PII. 32 bytes as hex (64 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# ── Web Push / VAPID (notifications) ────────────────────────────────────────────
# Generate a keypair: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:derrickfung87@gmail.com

# ── Off-box DB backup (Litestream → S3) ─────────────────────────────────────────
# When LITESTREAM_S3_BUCKET is set, scripts/start.sh streams the SQLite WAL to S3
# and restores on a fresh volume. Leave unset for local dev.
LITESTREAM_S3_BUCKET=
LITESTREAM_S3_ACCESS_KEY_ID=
LITESTREAM_S3_SECRET_ACCESS_KEY=
LITESTREAM_S3_REGION=us-east-1

# ── External services ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
